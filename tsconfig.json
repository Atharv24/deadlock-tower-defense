{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "modlock": ["./mods/deadlock_td/node_modules/modlock/index.d.ts"],
      "modlock/*": ["./mods/deadlock_td/node_modules/modlock/*"],
      "@base": ["./base/index.ts"],
      "@base/*": ["./base/*"],
      "@engine": ["./engine/index.ts"],
      "@engine/*": ["./engine/*"],
      "@ui": ["./ui/index.ts"],
      "@ui/*": ["./ui/*"],
      "@components/*": ["./components/*"]
    }
  },
  "include": [
    "base/**/*.ts",
    "engine/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx"
  ],
  "exclude": [
    "**/*_test.ts",
    "**/*.test.ts",
    "testing",
    "tools",
    "mods",
    "build",
    "node_modules"
  ]
}
